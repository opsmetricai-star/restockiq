# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Set to your live domain (https://...) so auth emails always link to it. Leave empty to use the browser origin.
NEXT_PUBLIC_SITE_URL=

# Server only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated emails allowed to verify payments at /app/admin
ADMIN_EMAILS=
